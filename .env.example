# LedgerLoop — optional LLM provider keys.
#
# None of these are required. `make demo` and the full test suite run with
# zero keys set: the provider fallback chain resolves to NullProvider, which
# abstains on every Tier 3 call, and everything it would have adjudicated
# flows to the exception queue instead. See src/ledgerloop/adjudicate/provider.py.
#
# Resolution order (first available wins):
#   1. GEMINI_API_KEY       — Google AI Studio free tier
#   2. GROQ_API_KEY         — Groq free tier
#   3. OPENROUTER_API_KEY   — OpenRouter free-tier model
#   4. local Ollama on localhost:11434
#   5. NullProvider (abstains on everything)

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Only needed if you want to point at a non-default local Ollama host.
OLLAMA_HOST=http://localhost:11434
