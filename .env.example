# LedgerLoop — optional LLM provider keys.
#
# Copy to `.env` (gitignored) and fill in whichever you have. This file IS read:
# src/ledgerloop/env.py loads it at chain resolution. A real environment variable
# always wins over this file, so your shell can override it without editing anything.
#
# None of these are required. `make demo` and the full test suite run with zero keys
# set: the provider fallback chain resolves to NullProvider, which abstains on every
# Tier 3 call, and everything it would have adjudicated flows to the exception queue
# instead. See src/ledgerloop/adjudicate/provider.py.
#
# Resolution order (first available wins):
#   1. GEMINI_API_KEY       — Google AI Studio free tier
#   2. GROQ_API_KEY         — Groq free tier
#   3. OPENROUTER_API_KEY   — OpenRouter free-tier model
#   4. local Ollama on localhost:11434
#   5. NullProvider (abstains on everything)
#
# A key left empty below counts as absent, not as "configured with a blank key".

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Only needed if you want to point at a non-default local Ollama host.
OLLAMA_HOST=http://localhost:11434

# Pin the chain to ONE provider by name: gemini, groq, openrouter, ollama, none.
# This is the portable way to force the local model while a cloud key stays set --
# "unset the key" is not, because PowerShell deletes a variable when you assign ""
# to it while POSIX shells pass a real empty string. A pinned provider that isn't
# available abstains rather than falling through to a different one.
# LEDGERLOOP_PROVIDER=ollama
